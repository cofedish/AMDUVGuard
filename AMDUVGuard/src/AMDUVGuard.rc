#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "AMDUVGuard.ico"

// Manifest is supplied via the project's <Manifest> tool (AdditionalManifestFiles).
// Embedding it here as well caused CVT1100 duplicate-resource errors.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AMDUVGuard"
            VALUE "FileDescription",  "AMD undervolt watchdog"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AMDUVGuard"
            VALUE "OriginalFilename", "AMDUVGuard.exe"
            VALUE "ProductName",      "AMDUVGuard"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
